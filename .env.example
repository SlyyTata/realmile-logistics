# Copy to .env and fill in real values. Never commit .env.

# Neon connection string: use the postgresql+asyncpg:// prefix and
# remove any ?sslmode=... query string (SSL is enabled in code).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME

# Auth. Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# Log every SQL statement (development only)
DEBUG=false

# URL the browser uses to reach the API. Read by docker compose as a
# build arg for the frontend image (baked in at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
